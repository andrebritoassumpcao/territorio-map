# Persistência do mapa (Supabase) — copie para `.env.local` e preencha.
# Sem estas variáveis, o mapa funciona só em memória (dados somem ao recarregar).
# Encontre os valores em: Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key
